marks_list = []
grade_counts = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0}

for i in range(1, 11):
    while True:
        mark = float(input(f"Enter marks for student {i} (0-100): "))
        if 0 <= mark <= 100:
            marks_list.append(mark)
            break
        print("Invalid input! Marks must be between 0 and 100.")

    if mark >= 90:
        grade = "A"
    elif mark >= 80:
        grade = "B"
    elif mark >= 70:
        grade = "C"
    elif mark >= 60:
        grade = "D"
    else:
        grade = "F"

    grade_counts[grade] += 1
    print(f"Student {i} Grade: {grade}")

print("\n--- Class Performance Summary ---")
print(f"Average Marks: {sum(marks_list) / len(marks_list):.2f}")
print(f"Highest Mark: {max(marks_list)}")
print(f"Lowest Mark: {min(marks_list)}")
print("Grade Distribution:", grade_counts)
