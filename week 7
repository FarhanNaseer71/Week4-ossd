rows = int(input("Enter number of rows: "))

print("\n1. Right-Angled Triangle:")
for i in range(1, rows + 1):
    print("* " * i)

print("\n2. Pyramid Pattern:")
for i in range(1, rows + 1):
    print(" " * (rows - i) + "* " * i)

print("\n3. Number Triangle:")
for i in range(1, rows + 1):
    for j in range(1, i + 1):
        print(j, end=" ")
    print()
